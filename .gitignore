# Keep firmware, app binaries, credentials and VM data out of Git.
*.img
*.apk
*.zip
*.tar.xz
*.part[0-9]*
*.partial
*.pem
*.key
*.pk8
.env
.gh-config/
__pycache__/
*.py[cod]
/build/
/dist/
/work/
/images/

# Small, deliberate resource patches; no ROM or vendor APK blobs.
!assets/AEGuestRecents.apk
!assets/icons.static.zip
