EXTRACT_R3 boot.img
EXTRACT_R3 system.img
EXTRACT_R3 vendor.img
INSTALL /system/etc/aemu-compat/display-profile.sh
INSTALL /system/etc/aemu-compat/start-spawner.sh
INSTALL /system/etc/aemu-compat/start-surfaceflinger.sh
INSTALL /system/etc/init/surfaceflinger.rc
INSTALL /product/overlay/AEGuestRecents/AEGuestRecents.apk
INSTALL /system/media/theme/default/icons
BROWSER_LIBRARIES 66
FSCK system.img
FSCK vendor.img
HASH boot.img
HASH system.img
HASH vendor.img
ZIP9 boot.img
ZIP9 system.img
ZIP9 vendor.img
ZIP9 AE-INTEGRATED.json
ZIP9 使用说明.md
VERIFY_ZIP boot.img
VERIFY_ZIP system.img
VERIFY_ZIP vendor.img
VERIFY_ZIP AE-INTEGRATED.json
VERIFY_ZIP 使用说明.md
